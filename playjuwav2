/* =========================================================
   HALLOWEEN FX — decorative layer (pointer-events: none)
   ========================================================= */
.hw{position:fixed;inset:0;z-index:30;overflow:hidden;pointer-events:none;contain:layout paint}
.hw[data-on="false"]{display:none}
.hw-p{position:absolute;left:0;top:0;will-change:transform;opacity:0}
.hw-p img{display:block;width:100%;height:auto;will-change:transform}
/* witches — sweep across on a wavy path, then rest off-screen */
.hw-witch{width:150px;filter:drop-shadow(0 0 14px rgba(255,140,40,.45))}
.hw-witch.is-a{animation:hw-witch-a 32s linear infinite}
.hw-witch.is-a img{animation:hw-bob 2.4s ease-in-out infinite}
.hw-witch.is-b{width:96px;animation:hw-witch-b 40s linear -18s infinite;filter:drop-shadow(0 0 10px rgba(168,85,247,.5)) blur(.4px)}
.hw-witch.is-b img{transform:scaleX(-1);animation:hw-bob-flip 2.8s ease-in-out infinite}
@keyframes hw-witch-a{
  0%{transform:translate(-20vw,16vh) rotate(-6deg);opacity:0}
  2%{opacity:.95}
  10%{transform:translate(12vw,8vh) rotate(-2deg)}
  20%{transform:translate(38vw,20vh) rotate(4deg)}
  30%{transform:translate(64vw,10vh) rotate(-4deg)}
  40%{transform:translate(92vw,22vh) rotate(3deg)}
  44%{transform:translate(112vw,14vh);opacity:.95}
